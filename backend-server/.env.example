# ─────────────────────────────────────────────────────────────────────────────
# Gym Buddy — Environment Variables Example
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# NVIDIA NIM API Key (DeepSeek vision model via OpenAI-compatible endpoint)
# Get yours free at: https://build.nvidia.com/
NVIDIA_API_KEY=
# JWT secret key for signing/verifying user auth tokens.
# Use a long, random string — at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
